---
import { url } from '../lib/utils';

interface Props {
  items: { image: string; caption?: string }[];
}

const { items } = Astro.props;
---

<section class="gallery" aria-label="Gallery">
  {
    items.map((item) => (
      <figure>
        <a href={url(item.image)} data-lightbox data-caption={item.caption ?? ''}>
          <img src={url(item.image)} alt={item.caption ?? ''} loading="lazy" decoding="async" />
        </a>
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    ))
  }
</section>

<dialog class="lightbox" aria-label="Image viewer">
  <button type="button" class="close" aria-label="Close">×</button>
  <img alt="" />
  <p class="caption"></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const img = dialog.querySelector('img')!;
  const caption = dialog.querySelector('.caption')!;

  document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      img.src = link.href;
      img.alt = link.dataset.caption ?? '';
      caption.textContent = link.dataset.caption ?? '';
      dialog.showModal();
    });
  });

  // Close on the button or a click on the backdrop.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || (e.target as Element).closest('.close')) dialog.close();
  });
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
    margin: 2.5rem 0;
  }
  figure { margin: 0; }
  figure img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--border);
    cursor: zoom-in;
  }
  figcaption { font-size: 0.88rem; color: var(--muted); margin-top: 0.4rem; }

  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 94vw;
    max-height: 94vh;
    overflow: visible;
  }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.85); }
  .lightbox img { max-width: 94vw; max-height: 86vh; object-fit: contain; border-radius: 6px; }
  .lightbox .caption { color: #eee; text-align: center; margin: 0.6rem 0 0; font-size: 0.95rem; }
  .lightbox .caption:empty { display: none; }
  .close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 0;
    background: rgb(255 255 255 / 0.15);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
</style>
