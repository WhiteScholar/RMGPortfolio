---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { url } from '../lib/utils';

const about = (await getEntry('pages', 'about'))!;
const { Content } = await render(about);
const { portrait, resume } = about.data;
---

<Base title={about.data.title}>
  <section class="container about">
    {portrait && <img class="portrait" src={url(portrait)} alt={site.name} />}
    <div>
      <h1>{about.data.title}</h1>
      <div class="prose"><Content /></div>
      {
        site.email && (
          <p class="contact">
            <span class="muted">Email</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        )
      }
      {
        resume && (
          <div class="actions">
            <a class="button secondary" href={url(resume)} target="_blank" rel="noopener">Résumé (PDF)</a>
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    gap: 3rem;
    padding-top: 3.5rem;
    align-items: start;
  }
  .about:not(:has(.portrait)) { grid-template-columns: minmax(0, 1fr); }
  .portrait { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); }
  h1 { margin-top: 0; font-size: clamp(1.8rem, 4vw, 2.4rem); }
  .contact { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; align-items: baseline; margin: 2rem 0 0; }
  .contact .muted { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .contact a { color: var(--accent); font-weight: 600; overflow-wrap: anywhere; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  @media (max-width: 700px) {
    .about { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .portrait { max-width: 240px; }
  }
</style>
