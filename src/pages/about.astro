---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { url } from '../lib/utils';

const about = (await getEntry('pages', 'about'))!;
const { Content } = await render(about);
const { portrait, resume } = about.data;
---

<Base title={about.data.title}>
  <section class="container about">
    {portrait && <img class="portrait" src={url(portrait)} alt={site.name} />}
    <div>
      <h1>{about.data.title}</h1>
      <div class="prose"><Content /></div>
      <div class="actions">
        {site.email && <a class="button" href={`mailto:${site.email}`}>Email me</a>}
        {resume && <a class="button secondary" href={url(resume)} target="_blank" rel="noopener">Résumé (PDF)</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    gap: 3rem;
    padding-top: 3.5rem;
    align-items: start;
  }
  .about:not(:has(.portrait)) { grid-template-columns: minmax(0, 1fr); }
  .portrait { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); }
  h1 { margin-top: 0; font-size: clamp(1.8rem, 4vw, 2.4rem); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  @media (max-width: 700px) {
    .about { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .portrait { max-width: 240px; }
  }
</style>
